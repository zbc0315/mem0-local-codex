{
  "mcpServers": {
    "mem0-local": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "./core/mcp_server.py"
      ],
      "cwd": ".",
      "env_vars": [
        "MEM0_LOCAL_URL",
        "MEM0_LOCAL_API_KEY",
        "MEM0_LOCAL_CONFIG",
        "MEM0_CODE_USER_ID",
        "MEM0_USER_ID",
        "MEM0_CODE_DATA_DIR"
      ]
    }
  }
}
